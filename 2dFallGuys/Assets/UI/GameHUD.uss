/* ========================================= */
/* HUD PRINCIPAL ESTIL MINIMALISTA           */
/* ========================================= */
.hud-container {
    width: 100%;
    height: 100%;
    padding: 40px;
}

.main-hud-content {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    flex-direction: row; 
    align-items: flex-start;
}

.stats-zone {
    flex-direction: column;
    align-items: flex-start;
}

.kpi-container {
    flex-direction: row;
    align-items: flex-end; 
}

/* Temps gran sense fons sòlid */
.kpi-timer-text {
    font-size: 80px;
    -unity-font-style: bold;
    color: #ffffff;
    text-shadow: 3px 3px 6px rgba(0,0,0,0.4);
    margin: 0; padding: 0;
    -unity-text-align: middle-left;
}

.kpi-timer-unit {
    font-size: 35px;
    color: #f39c12;
    -unity-font-style: bold;
    margin-bottom: 15px; 
    margin-left: 8px;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
}

.coins-container {
    margin-top: 15px;
}

.kpi-coin-icon {
    font-size: 50px;
    color: #f1c40f;
    margin-bottom: -5px; 
    text-shadow: 0px 0px 15px rgba(241,196,15,0.7);
}

.kpi-coins-text {
    font-size: 55px;
    -unity-font-style: bold;
    color: #ffffff;
    margin-left: 12px;
    text-shadow: 3px 3px 6px rgba(0,0,0,0.4);
}

/* ========================================= */
/* MODE ESPECTADOR MINIMALISTA               */
/* ========================================= */
.spectator-container {
    position: absolute;
    bottom: 20px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 10, 18, 0.7);
    padding: 8px 15px;
    border-radius: 25px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.spectator-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: #ecf0f1;
    margin: 0 15px;
    letter-spacing: 2px;
}

.spectator-btn {
    background-color: rgba(255, 255, 255, 0.1);
    color: #bdc3c7;
    font-size: 18px;
    -unity-font-style: bold;
    border-radius: 15px;
    border-width: 0;
    width: 35px;
    height: 35px;
    transition-property: background-color, color, scale;
    transition-duration: 0.2s;
    cursor: url('link');
    margin: 0;
    padding: 0;
}

.spectator-btn:hover {
    background-color: rgba(255, 255, 255, 0.3);
    color: #ffffff;
    scale: 1.1;
}

/* ========================================= */
/* LEADERBOARD ANIMAT I ORGÀNIC              */
/* ========================================= */
.leaderboard-wrapper {
    width: 280px;
    height: 100%;
}

.leaderboard-dynamic-container {
    position: relative;
    width: 100%;
    height: 100%;
}

.leaderboard-pill {
    position: absolute;
    right: 0; 
    width: 100%;
    
    /* Transicions USS per moviment suau quan canvia posició */
    transition-property: top, background-color, scale, border-width;
    transition-duration: 0.5s, 0.3s, 0.3s, 0.3s;
    transition-timing-function: ease-out-bounce, ease, ease, ease;
    
    flex-direction: row;
    align-items: center;
    background-color: rgba(20, 20, 30, 0.5);
    border-radius: 30px; /* Píndola */
    padding: 10px 20px;
    border-left-color: #3498db;
    border-left-width: 4px;
}

.leaderboard-pill.local-player {
    border-left-color: #2ecc71;
    background-color: rgba(46, 204, 113, 0.25);
}

.leaderboard-pill.rank-1 {
    scale: 1.08; /* El lider destaca */
    background-color: rgba(52, 152, 219, 0.6);
    border-left-width: 12px;
    border-bottom-right-radius: 5px; /* Trenca simetria */
}

.lb-pos {
    color: rgba(255,255,255,0.8);
    font-size: 22px;
    -unity-font-style: bold;
    width: 40px;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
}
.lb-name {
    color: #fff;
    font-size: 18px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
}


/* ========================================= */
/* PANTALLA DE RESULTATS                     */
/* ========================================= */
.result-backdrop {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 15, 25, 0.85);
    justify-content: center;
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.6s;
    transition-timing-function: ease-out;
}

.result-hidden {
    opacity: 0;
}

/* Disseny geometria pura sense 'caixa' restrictiva massissa */
.result-box {
    width: 600px;
    min-height: 500px;
    align-items: center;
    background-color: rgba(0,0,0,0); /* sense fons visible gran part */
    transition-property: translate, opacity;
    transition-duration: 0.7s, 0.7s;
    transition-timing-function: ease-out-back, ease-out;
}

.result-box-hidden {
    translate: 0 80px;
    opacity: 0;
}

.result-title {
    color: #fff;
    font-size: 42px;
    letter-spacing: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 50px;
    text-shadow: 0px 5px 15px rgba(231,76,60, 0.8); 
}

/* PODI GEOMÈTRIC */
.podium-geometric-container {
    flex-direction: row;
    height: 180px;
    align-items: flex-end;
    justify-content: center;
    margin-bottom: 40px;
    width: 100%;
}

.podpos {
    align-items: center;
    margin: 0 15px;
}

.pod-bar {
    width: 90px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
}

.pod-bar-1 { height: 140px; background-color: rgba(241,196,15, 0.85); }
.pod-bar-2 { height: 90px; background-color: rgba(189,195,199, 0.85); }
.pod-bar-3 { height: 60px; background-color: rgba(205,127,50, 0.85); }

.pod-lbl {
    font-size: 18px;
    color: #fff;
    -unity-font-style: bold;
    margin-bottom: 10px;
    background-color: rgba(255,255,255,0.15);
    padding: 5px 10px;
    border-radius: 8px;
}

/* LLISTA ALTRES JUGADORS */
.others-list {
    flex-grow: 1;
    width: 90%;
    margin-bottom: 30px;
}

.other-item {
    flex-direction: row;
    justify-content: space-between;
    padding: 10px 20px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    margin-bottom: 8px;
}
.other-text {
    color: rgba(255,255,255,0.9);
    font-size: 16px;
    -unity-font-style: bold;
}

/* BOTÓ TORNAR FLUID */
.btn-tornar {
    background-color: transparent;
    color: #fff;
    font-size: 20px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    padding: 15px 40px;
    border-radius: 30px;
    border-width: 2px;
    border-color: #fff;
    transition-property: background-color, color, scale;
    transition-duration: 0.3s;
    cursor: url('link');
}

.btn-tornar:hover {
    background-color: #fff;
    color: #000;
    scale: 1.05;
}
